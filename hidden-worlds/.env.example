# Copy to .env and fill in what you need. With no .env the app makes no request to any other
# origin (ADPT-7), and every adapter is a no-op.

# PostHog project API key. When set, anonymous usage events are sent to PostHog after the
# player's first tap (no autocapture, no session recording, no person profiles).
VITE_POSTHOG_KEY=
# PostHog host. Default: https://us.i.posthog.com (use https://eu.i.posthog.com for EU cloud).
VITE_POSTHOG_HOST=

# Where the Premium "Tell me when it's ready" form POSTs { email, source } as JSON.
# When empty, the Premium screen shows no email field.
VITE_WAITLIST_URL=

# Public address the game is deployed at, e.g. https://example.com/ . Used to make the
# Open Graph and Twitter image URLs absolute, which link previews need.
VITE_SITE_URL=
