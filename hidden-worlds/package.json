{
  "name": "hidden-worlds",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0 && prettier --check . --log-level warn",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview",
    "budget": "tsx tools/budget.ts",
    "e2e": "npm run -s build:e2e && playwright test",
    "pack:build": "tsx tools/pack-build.ts",
    "pack:export-sample": "tsx tools/pack-export-sample.ts",
    "pack:validate": "tsx tools/pack-validate.ts",
    "world:audit": "node --expose-gc --import tsx tools/world-audit.ts",
    "calendar": "tsx tools/calendar.ts",
    "golden": "tsx tools/golden.ts",
    "verify": "tsx tools/verify.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@napi-rs/canvas": "^1.1.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  }
}
